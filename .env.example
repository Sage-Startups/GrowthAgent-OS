# Database
DATABASE_URL="postgresql://user:password@localhost:5432/growthagent_os"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-min-32-chars-change-this"

# Stripe (optional for development)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="GrowthAgent OS"

# Agent Provider (local | openclaw)
AGENT_PROVIDER=local
OPENCLAW_DEFAULT_GATEWAY_URL=
OPENCLAW_DEFAULT_API_KEY=

# Email Provider (none | resend | sendgrid)
EMAIL_PROVIDER=none
RESEND_API_KEY=
SENDGRID_API_KEY=
FROM_EMAIL=

# Job secret for protected background job endpoints
JOB_SECRET=

# Voice Provider (local | vapi | twilio)
VOICE_PROVIDER=local
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VOICE_WEBHOOK_SECRET=
