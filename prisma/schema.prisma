generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum VoiceDirection {
  INBOUND
  OUTBOUND
  BROWSER
}

enum SetupStatus {
  NEW
  ONBOARDING
  CONFIGURING
  TESTING
  LIVE
  PAUSED
}

enum LeadStatus {
  NEW
  RESEARCHING
  QUALIFIED
  HOT
  WARM
  COLD
  BAD_FIT
  REPLIED
  FOLLOW_UP_DUE
  CALL_BOOKED
  PROPOSAL_SENT
  WON
  LOST
}

enum ScoreBand {
  HOT
  WARM
  COLD
  BAD_FIT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  DRAFT_EMAIL
  CRM_STATUS_CHANGE
  FOLLOW_UP
  CALL_SCRIPT
  PROPOSAL_OUTLINE
  SEND_EMAIL
  BOOK_CALL
  SEND_PROPOSAL
  DELETE_LEAD
  EXPORT_DATA
  COMPETITOR_RESEARCH
  CLIENT_ONBOARDING
}

enum AgentStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  COMING_SOON
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  role           Role            @default(USER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  sessions       Session[]
  companyMembers CompanyMember[]
  auditLogs      AuditLog[]
}

model Company {
  id                   String          @id @default(cuid())
  name                 String
  website              String?
  businessType         String?
  mainOffer            String?
  averageDealValue     Float?
  idealCustomerProfile String?         @db.Text
  badFitTraits         String?         @db.Text
  leadSources          String[]
  currentCRM           String?
  toneOfVoice          String?
  approvalPreference   String?
  leadScoringPriorities String?        @db.Text
  setupStatus          SetupStatus     @default(NEW)
  stripeCustomerId     String?         @unique
  stripeSubscriptionId String?         @unique
  stripePlanName       String?
  stripePlanStatus     String?
  stripeTrialEnd       DateTime?
  apiKey               String?         @unique
  // Agent provider config
  openclawEnabled      Boolean   @default(false)
  openclawGatewayUrl   String?
  openclawAgentId      String?
  openclawWorkspaceId  String?
  openclawApiKey       String?
  openclawChannel      String?
  openclawSetupStatus  String?
  openclawLastTestedAt DateTime?
  // Voice config
  voiceEnabled         Boolean   @default(false)
  voiceProvider        String?
  vapiAssistantId      String?
  twilioPhoneNumber    String?
  voiceWebhookSecret   String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  members              CompanyMember[]
  leads                Lead[]
  agents               Agent[]
  approvalRequests     ApprovalRequest[]
  integrations         Integration[]
  reports              Report[]
  auditLogs            AuditLog[]
  subscriptions        Subscription[]
  webhookEvents        WebhookEvent[]
  voiceCalls           VoiceCall[]
}

model CompanyMember {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  description   String?
  setupFee      Float
  monthlyPrice  Float
  features      String[]
  stripePriceId String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id                   String    @id @default(cuid())
  companyId            String
  planId               String
  status               String    @default("active")
  stripeSubscriptionId String?   @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan                 Plan      @relation(fields: [planId], references: [id])
}

model Lead {
  id                 String      @id @default(cuid())
  companyId          String
  name               String
  email              String?
  phone              String?
  companyName        String?
  website            String?
  source             String?
  message            String?     @db.Text
  status             LeadStatus  @default(NEW)
  score              Int?
  scoreBand          ScoreBand?
  estimatedValue     Float?
  painPoints         String?     @db.Text
  fitSummary         String?     @db.Text
  researchSummary    String?     @db.Text
  recommendedAction  String?     @db.Text
  draftReply         String?     @db.Text
  nextFollowUpAt     DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notes              LeadNote[]
  scores             LeadScore[]
  agentTasks         AgentTask[]
  approvalRequests   ApprovalRequest[]
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  content   String   @db.Text
  authorId  String?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadScore {
  id         String    @id @default(cuid())
  leadId     String
  score      Int
  scoreBand  ScoreBand
  reasoning  String?   @db.Text
  agentRunId String?
  createdAt  DateTime  @default(now())
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Agent {
  id               String            @id @default(cuid())
  companyId        String
  name             String
  type             String
  description      String?
  status           AgentStatus       @default(ACTIVE)
  config           Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages         AgentMessage[]
  tasks            AgentTask[]
  runs             AgentRun[]
  approvalRequests ApprovalRequest[]
}

model AgentMessage {
  id        String   @id @default(cuid())
  agentId   String
  role      String
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model AgentTask {
  id          String     @id @default(cuid())
  agentId     String
  leadId      String?
  title       String
  description String?    @db.Text
  status      TaskStatus @default(PENDING)
  result      String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  agent       Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead        Lead?      @relation(fields: [leadId], references: [id])
}

model AgentRun {
  id         String   @id @default(cuid())
  agentId    String
  status     String
  input      Json?
  output     Json?
  error      String?  @db.Text
  durationMs Int?
  createdAt  DateTime @default(now())
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model ApprovalRequest {
  id               String         @id @default(cuid())
  companyId        String
  leadId           String?
  createdByAgentId String?
  type             ApprovalType
  title            String
  description      String?        @db.Text
  proposedAction   String         @db.Text
  payload          Json?
  status           ApprovalStatus @default(PENDING)
  reviewedAt       DateTime?
  reviewedBy       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead             Lead?          @relation(fields: [leadId], references: [id])
  agent            Agent?         @relation(fields: [createdByAgentId], references: [id])
}

model Integration {
  id          String            @id @default(cuid())
  companyId   String
  name        String
  type        String
  status      IntegrationStatus @default(COMING_SOON)
  config      Json?
  credentials Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Report {
  id        String   @id @default(cuid())
  companyId String
  type      String
  title     String
  data      Json
  period    String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  company    Company? @relation(fields: [companyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

model VoiceCall {
  id           String         @id @default(cuid())
  companyId    String
  leadId       String?
  provider     String         @default("local")
  direction    VoiceDirection @default(BROWSER)
  status       String         @default("pending")
  phoneNumber  String?
  duration     Int?
  transcript   String?        @db.Text
  summary      String?        @db.Text
  recording    String?
  recordingUrl String?
  startedAt    DateTime?
  endedAt      DateTime?
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String   @id @default(cuid())
  companyId   String?
  source      String
  eventType   String
  payload     Json
  processed   Boolean  @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())
  company     Company? @relation(fields: [companyId], references: [id])
}
